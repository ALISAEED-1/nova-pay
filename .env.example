# Copy to .env and adjust. Every value has a development default.

PORT=4000
# Interface to listen on. 127.0.0.1 works with `adb reverse` over USB;
# use 0.0.0.0 to reach the server from a phone on the same Wi-Fi.
HOST=127.0.0.1
# The address phones and browsers use to reach this server. Checkout links
# and return URLs are built from it.
PUBLIC_BASE_URL=http://localhost:4000

JWT_SECRET=change-me-in-production
MOCK_WEBHOOK_SECRET=whsec_mock_change_me

# Leave DATABASE_URL empty to use the embedded PGlite database stored in
# PGLITE_DATA_DIR. Set it to a real Postgres URL (Supabase, Neon, local) later.
DATABASE_URL=
PGLITE_DATA_DIR=./data/pglite

# Stripe test mode for US/EU customers. Leave empty to use the mock provider
# everywhere. Live keys (sk_live_…) are refused.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:4000/v1/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=

# How often the renewal job runs (milliseconds).
BILLING_INTERVAL_MS=60000
# Development helpers (POST /v1/dev/advance-clock). Always off in production.
DEV_TOOLS=true
